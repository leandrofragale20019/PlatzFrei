<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "PlatzFrei" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="PlatzFrei — Sportplätze im Verein reservieren, ohne Doppelbuchungen.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Platz Frei">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#131926">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#hauptinhalt" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
      Zum Inhalt springen
    </a>

    <header class="sticky top-0 z-40 border-b border-neutral-200/70 bg-white/80 backdrop-blur-md" data-controller="nav">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex h-16 items-center justify-between gap-4">
          <%= link_to root_path, class: "flex items-center gap-2 text-lg font-extrabold tracking-tight text-neutral-900 no-underline hover:no-underline hover:text-neutral-900" do %>
            <span class="flex size-9 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm shadow-primary-600/30">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M11.5 3a17 17 0 0 0 0 18M12.5 3a17 17 0 0 1 0 18" />
              </svg>
            </span>
            PlatzFrei
          <% end %>

          <% if angemeldet? %>
            <nav class="hidden items-center gap-1 md:flex" aria-label="Hauptnavigation">
              <% mitglied_navigation.each do |link| %>
                <%= link_to link[:label], link[:path],
                      class: class_names("nav-link", "nav-link-active" => nav_aktiv?(link[:path])),
                      aria: { current: ("page" if nav_aktiv?(link[:path])) } %>
              <% end %>
            </nav>
          <% end %>

          <div class="hidden items-center gap-3 md:flex">
            <% if angemeldet? %>
              <% if current_benutzer.verantwortlicher? %>
                <%= link_to admin_benutzer_path,
                      class: class_names("btn btn-secondary !py-2 gap-1.5", "!border-primary-300 !text-primary-700 !bg-primary-50" => im_admin_bereich?),
                      aria: { current: ("page" if im_admin_bereich?) } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
                  </svg>
                  Verwaltung
                <% end %>
              <% end %>

              <div class="flex items-center gap-2 border-l border-neutral-200 pl-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-neutral-200 text-xs font-bold text-neutral-600">
                  <%= current_benutzer.name.first&.upcase %>
                </div>
                <div class="leading-tight">
                  <p class="text-sm font-semibold text-neutral-800"><%= current_benutzer.name %></p>
                  <p class="text-xs text-neutral-500"><%= current_benutzer.verantwortlicher? ? "Platzverantwortliche/r" : "Vereinsmitglied" %></p>
                </div>
                <%= button_to sitzung_path, method: :delete, class: "ml-1 rounded-lg p-2 text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-900", form_class: "inline", aria: { label: "Abmelden" }, title: "Abmelden" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
                  </svg>
                <% end %>
              </div>
            <% else %>
              <%= link_to "Anmelden", new_sitzung_path, class: "nav-link" %>
              <%= render "shared/button", label: "Registrieren", variant: :primary, href: new_registrierung_path %>
            <% end %>
          </div>

          <button type="button" data-nav-target="button" data-action="nav#toggle" aria-expanded="false" aria-controls="mobile-menu"
                  class="inline-flex items-center justify-center rounded-lg p-2 text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 md:hidden
                         focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500">
            <span class="sr-only">Menü öffnen</span>
            <svg data-nav-target="menuIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
            <svg data-nav-target="closeIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" data-nav-target="panel" class="hidden border-t border-neutral-200 bg-white px-4 py-3 md:hidden">
        <% if angemeldet? %>
          <nav class="space-y-1" aria-label="Hauptnavigation (mobil)">
            <% mitglied_navigation.each do |link| %>
              <%= link_to link[:label], link[:path],
                    class: class_names("block", "nav-link", "nav-link-active" => nav_aktiv?(link[:path])),
                    aria: { current: ("page" if nav_aktiv?(link[:path])) } %>
            <% end %>
          </nav>

          <% if current_benutzer.verantwortlicher? %>
            <div class="mt-3 border-t border-neutral-200 pt-3">
              <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-neutral-400">Verwaltung</p>
              <% admin_navigation.each do |link| %>
                <%= link_to link[:label], link[:path],
                      class: class_names("block", "nav-link", "nav-link-active" => nav_aktiv?(link[:path])),
                      aria: { current: ("page" if nav_aktiv?(link[:path])) } %>
              <% end %>
            </div>
          <% end %>

          <div class="mt-3 flex items-center justify-between border-t border-neutral-200 pt-3">
            <div class="px-3">
              <p class="text-sm font-semibold text-neutral-800"><%= current_benutzer.name %></p>
              <p class="text-xs text-neutral-500"><%= current_benutzer.verantwortlicher? ? "Platzverantwortliche/r" : "Vereinsmitglied" %></p>
            </div>
            <%= button_to "Abmelden", sitzung_path, method: :delete, class: "btn btn-secondary", form_class: "inline" %>
          </div>
        <% else %>
          <div class="space-y-1">
            <%= link_to "Anmelden", new_sitzung_path, class: "block nav-link" %>
            <%= link_to "Registrieren", new_registrierung_path, class: "block nav-link" %>
          </div>
        <% end %>
      </div>
    </header>

    <% if im_admin_bereich? && angemeldet? && current_benutzer.verantwortlicher? %>
      <%= render "shared/admin_subnav" %>
    <% end %>

    <main id="hauptinhalt" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-neutral-200/70">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-neutral-400 sm:flex-row sm:px-6">
        <p>PlatzFrei — Sportplatzreservierung</p>
        <p>Modul M233 · Multiuser-Applikation</p>
      </div>
    </footer>
  </body>
</html>
