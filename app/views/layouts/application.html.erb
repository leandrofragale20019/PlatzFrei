<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "PlatzFrei" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="PlatzFrei: Sportplätze im Verein reservieren, ohne Doppelbuchungen.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Platz Frei">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#131926">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&display=swap">
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#hauptinhalt" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white">
      Zum Inhalt springen
    </a>

    <header class="sticky top-0 z-40 px-4 pt-4 sm:px-6" data-controller="nav">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-full border border-white/70 bg-white/60 py-2 pl-5 pr-2 backdrop-blur-xl">
          <div class="flex h-11 items-center justify-between gap-4">
            <%= link_to root_path, class: "flex items-center gap-2.5 font-display text-xl font-medium tracking-tight text-neutral-900 no-underline hover:no-underline hover:text-neutral-900" do %>
              <span class="size-2.5 rounded-full bg-primary-600" aria-hidden="true"></span>
              PlatzFrei
            <% end %>

            <% if angemeldet? %>
              <nav class="hidden items-center gap-1 md:flex" aria-label="Hauptnavigation">
                <% mitglied_navigation.each do |link| %>
                  <%= link_to link[:label], link[:path],
                        class: class_names("nav-link", "nav-link-active" => nav_aktiv?(link[:path])),
                        aria: { current: ("page" if nav_aktiv?(link[:path])) } %>
                <% end %>
              </nav>
            <% end %>

            <div class="hidden items-center gap-2.5 md:flex">
              <% if angemeldet? %>
                <% if current_benutzer.verantwortlicher? %>
                  <%= link_to "Verwaltung", admin_benutzer_path,
                        class: class_names("nav-link", "nav-link-active" => im_admin_bereich?),
                        aria: { current: ("page" if im_admin_bereich?) } %>
                <% end %>

                <div class="flex items-center gap-2.5 rounded-full border border-neutral-900/10 bg-neutral-900/[0.03] py-1 pl-1 pr-2">
                  <span class="flex size-8 items-center justify-center rounded-full bg-primary-600 text-xs font-bold text-white"><%= current_benutzer.name.first&.upcase %></span>
                  <span class="leading-tight">
                    <span class="block text-sm font-semibold text-neutral-800"><%= current_benutzer.name %></span>
                    <span class="block text-[11px] text-neutral-500"><%= current_benutzer.verantwortlicher? ? "Platzverantwortliche/r" : "Vereinsmitglied" %></span>
                  </span>
                  <%= button_to "Abmelden", sitzung_path, method: :delete, class: "rounded-full px-3 py-1.5 text-sm font-medium text-neutral-600 transition-colors duration-300 hover:bg-neutral-900/5 hover:text-neutral-900", form_class: "inline" %>
                </div>
              <% else %>
                <%= link_to "Anmelden", new_sitzung_path, class: "nav-link" %>
                <%= render "shared/button", label: "Registrieren", variant: :primary, href: new_registrierung_path %>
              <% end %>
            </div>

            <button type="button" data-nav-target="button" data-action="nav#toggle" aria-expanded="false" aria-controls="mobile-menu"
                    class="flex size-10 items-center justify-center rounded-full text-neutral-600 transition-colors duration-200 ease-fluid hover:bg-neutral-900/5 hover:text-neutral-900 md:hidden
                           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500">
              <span class="sr-only">Menü öffnen</span>
              <svg data-nav-target="menuIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
              </svg>
              <svg data-nav-target="closeIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="hidden size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <div id="mobile-menu" data-nav-target="panel" class="mt-3 hidden rounded-3xl border border-white/70 bg-white/70 p-3 backdrop-blur-xl md:hidden">
          <% if angemeldet? %>
            <nav class="space-y-1" aria-label="Hauptnavigation (mobil)">
              <% mitglied_navigation.each do |link| %>
                <%= link_to link[:label], link[:path],
                      class: class_names("block", "nav-link", "nav-link-active" => nav_aktiv?(link[:path])),
                      aria: { current: ("page" if nav_aktiv?(link[:path])) } %>
              <% end %>
            </nav>

            <% if current_benutzer.verantwortlicher? %>
              <div class="mt-3 border-t border-neutral-200 pt-3">
                <p class="px-3.5 pb-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-neutral-400">Verwaltung</p>
                <% admin_navigation.each do |link| %>
                  <%= link_to link[:label], link[:path],
                        class: class_names("block", "nav-link", "nav-link-active" => nav_aktiv?(link[:path])),
                        aria: { current: ("page" if nav_aktiv?(link[:path])) } %>
                <% end %>
              </div>
            <% end %>

            <div class="mt-3 flex items-center justify-between gap-3 border-t border-neutral-200 pt-3">
              <div class="flex items-center gap-2.5 px-1">
                <span class="flex size-9 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white"><%= current_benutzer.name.first&.upcase %></span>
                <span class="leading-tight">
                  <span class="block text-sm font-semibold text-neutral-800"><%= current_benutzer.name %></span>
                  <span class="block text-[11px] text-neutral-500"><%= current_benutzer.verantwortlicher? ? "Platzverantwortliche/r" : "Vereinsmitglied" %></span>
                </span>
              </div>
              <%= render "shared/button", label: "Abmelden", variant: :secondary, href: sitzung_path, method: :delete %>
            </div>
          <% else %>
            <div class="space-y-1">
              <%= link_to "Anmelden", new_sitzung_path, class: "block nav-link" %>
              <%= link_to "Registrieren", new_registrierung_path, class: "block nav-link" %>
            </div>
          <% end %>
        </div>

        <% if im_admin_bereich? && angemeldet? && current_benutzer.verantwortlicher? %>
          <%= render "shared/admin_subnav" %>
        <% end %>
      </div>
    </header>

    <main id="hauptinhalt" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 sm:py-14">
      <%= render "shared/flash" %>
      <div data-controller="reveal">
        <%= yield %>
      </div>
    </main>

    <footer class="mt-auto px-4 pb-8 sm:px-6">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 border-t border-neutral-200/70 pt-6 text-xs text-neutral-400 sm:flex-row">
        <p>PlatzFrei · Sportplatzreservierung</p>
        <p>Modul M233 · Multiuser-Applikation</p>
      </div>
    </footer>
  </body>
</html>
