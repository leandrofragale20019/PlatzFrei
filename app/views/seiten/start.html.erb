<% content_for :title, "PlatzFrei" %>

<div class="relative overflow-hidden rounded-3xl border border-neutral-200/70 bg-white px-6 py-14 sm:px-12 sm:py-20">
  <div class="pointer-events-none absolute -right-16 -top-24 size-72 rounded-full bg-primary-100/60 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-10 size-72 rounded-full bg-success-100/50 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-2xl text-center">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700 ring-1 ring-inset ring-primary-600/20">
      Vereins-Platzreservierung
    </span>

    <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-neutral-900 sm:text-5xl">
      Sportplätze buchen,<br class="hidden sm:block"> ohne Doppelbuchungen.
    </h1>

    <% if angemeldet? %>
      <p class="mx-auto mt-5 max-w-xl text-lg text-neutral-600">
        Willkommen zurück, <strong class="font-semibold text-neutral-900"><%= current_benutzer.name %></strong>. Sieh dir freie Zeitfenster an oder verwalte deine Reservierungen.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <%= render "shared/button", label: "Freie Plätze ansehen", variant: :primary, href: zeitfenster_path %>
        <%= render "shared/button", label: "Meine Reservierungen", variant: :secondary, href: reservierungen_path %>
      </div>
    <% else %>
      <p class="mx-auto mt-5 max-w-xl text-lg text-neutral-600">
        Reserviere freie Zeitfenster auf den Sportplätzen deines Vereins — in Echtzeit, fair und ohne Konflikte.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <%= render "shared/button", label: "Konto erstellen", variant: :primary, href: new_registrierung_path %>
        <%= render "shared/button", label: "Anmelden", variant: :secondary, href: new_sitzung_path %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-8 grid gap-4 sm:grid-cols-3">
  <% [
       { icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", title: "In Echtzeit", text: "Reservierte Zeitfenster verschwinden sofort aus der Übersicht aller anderen." },
       { icon: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", title: "Konfliktfrei", text: "Bei gleichzeitigen Buchungen bekommt genau eine Person den Platz." },
       { icon: "M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776", title: "Mit Warteliste", text: "Ist ein Platz belegt, trägst du dich ein und wirst bei Stornierung frei." }
     ].each do |feature| %>
    <div class="card !p-5">
      <div class="mb-3 flex size-10 items-center justify-center rounded-xl bg-primary-50 text-primary-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= feature[:icon] %>" />
        </svg>
      </div>
      <h3><%= feature[:title] %></h3>
      <p class="mt-1 text-sm text-neutral-500"><%= feature[:text] %></p>
    </div>
  <% end %>
</div>
