<% content_for :title, "PlatzFrei" %>

<%= render "shared/card", core_class: "!p-0 overflow-hidden relative" do %>
  <div class="pointer-events-none absolute -right-24 -top-28 size-80 rounded-full bg-primary-200/50 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-28 -left-16 size-80 rounded-full bg-success-200/45 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-2xl px-6 py-16 text-center sm:px-10 sm:py-24">
    <span class="eyebrow">Vereins-Platzreservierung</span>

    <h1 class="mt-6 text-4xl font-extrabold leading-[1.05] tracking-tight text-neutral-900 sm:text-6xl">
      Sportplätze buchen,<br class="hidden sm:block"> ohne Doppelbuchungen.
    </h1>

    <% if angemeldet? %>
      <p class="mx-auto mt-6 max-w-xl text-lg text-neutral-600">
        Willkommen zurück, <strong class="font-semibold text-neutral-900"><%= current_benutzer.name %></strong>. Sieh dir freie Zeitfenster an oder verwalte deine Reservierungen.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <%= render "shared/button", label: "Freie Plätze ansehen", variant: :primary, icon: :arrow, href: zeitfenster_path %>
        <%= render "shared/button", label: "Meine Reservierungen", variant: :secondary, href: reservierungen_path %>
      </div>
    <% else %>
      <p class="mx-auto mt-6 max-w-xl text-lg text-neutral-600">
        Reserviere freie Zeitfenster auf den Sportplätzen deines Vereins — in Echtzeit, fair und ohne Konflikte.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <%= render "shared/button", label: "Konto erstellen", variant: :primary, icon: :arrow, href: new_registrierung_path %>
        <%= render "shared/button", label: "Anmelden", variant: :secondary, href: new_sitzung_path %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mt-6 grid gap-4 sm:grid-cols-3">
  <% [
       { icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", title: "In Echtzeit", text: "Reservierte Zeitfenster verschwinden sofort aus der Übersicht aller anderen." },
       { icon: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", title: "Konfliktfrei", text: "Bei gleichzeitigen Buchungen bekommt genau eine Person den Platz." },
       { icon: "M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776", title: "Mit Warteliste", text: "Ist ein Platz belegt, trägst du dich ein und wirst bei Stornierung frei." }
     ].each do |feature| %>
    <div class="tile">
      <div class="mb-3.5 flex size-11 items-center justify-center rounded-2xl bg-primary-50 text-primary-600 ring-1 ring-inset ring-primary-600/10">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= feature[:icon] %>" />
        </svg>
      </div>
      <h3><%= feature[:title] %></h3>
      <p class="mt-1.5 text-sm text-neutral-500"><%= feature[:text] %></p>
    </div>
  <% end %>
</div>
