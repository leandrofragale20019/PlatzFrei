<h1>Profil bearbeiten</h1>

<% if @benutzer.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@benutzer.errors.count, "Fehler") %> haben die Speicherung verhindert:</h2>
    <ul>
      <% @benutzer.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @benutzer, url: profil_path, method: :patch do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email, "E-Mail" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "Neues Passwort (optional)" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Neues Passwort bestätigen" %>
    <%= form.password_field :password_confirmation %>
  </div>

  <div>
    <%= form.submit "Speichern" %>
  </div>
<% end %>

<%= link_to "Zurück zum Profil", profil_path %>
