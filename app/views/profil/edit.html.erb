<% content_for :title, "Profil bearbeiten – PlatzFrei" %>

<div class="mx-auto max-w-2xl">
  <%= render "shared/page_header", eyebrow: "Mein Konto", title: "Profil bearbeiten", description: "Aktualisiere deinen Namen, deine E-Mail oder dein Passwort." %>

  <%= render "shared/card" do %>
    <% if @benutzer.errors[:base].present? %>
      <div class="mb-5 rounded-2xl bg-error-50 px-4 py-3 text-sm text-error-800 ring-1 ring-inset ring-error-600/20">
        <% @benutzer.errors[:base].each do |nachricht| %>
          <p><%= nachricht %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @benutzer, url: profil_path, method: :patch do |form| %>
      <%= render "shared/form_field", label: "Name", required: true, errors: @benutzer.errors[:name] do %>
        <%= form.text_field :name, class: form_input_classes(@benutzer.errors[:name]), required: true, autofocus: true, autocomplete: "name" %>
      <% end %>

      <%= render "shared/form_field", label: "E-Mail", required: true, errors: @benutzer.errors[:email] do %>
        <%= form.email_field :email, class: form_input_classes(@benutzer.errors[:email]), required: true, autocomplete: "email" %>
      <% end %>

      <div class="my-6 border-t border-neutral-100 pt-6">
        <p class="mb-4 text-sm font-semibold text-neutral-700">Passwort ändern <span class="font-normal text-neutral-400">(optional)</span></p>

        <%= render "shared/form_field", label: "Neues Passwort", errors: @benutzer.errors[:password], hint: "Leer lassen, um das Passwort nicht zu ändern" do %>
          <%= form.password_field :password, class: form_input_classes(@benutzer.errors[:password]), autocomplete: "new-password" %>
        <% end %>

        <%= render "shared/form_field", label: "Neues Passwort bestätigen", errors: @benutzer.errors[:password_confirmation] do %>
          <%= form.password_field :password_confirmation, class: form_input_classes(@benutzer.errors[:password_confirmation]), autocomplete: "new-password" %>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <%= render "shared/button", label: "Speichern", variant: :primary %>
        <%= link_to "Abbrechen", profil_path, class: "link-muted" %>
      </div>
    <% end %>
  <% end %>
</div>
