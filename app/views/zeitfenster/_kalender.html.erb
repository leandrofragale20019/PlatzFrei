<%#
  Liquid-Glass month picker. Pure view: each day links back to the overview
  with a `datum` param; the arrows page the month via a view-only `monat` param
  (the controller only reads `datum`/`sportart`, so nothing here is logic).

  Locals:
    angezeigt: Date — first day of the month being shown
    datum:     Date — the currently selected day
    sportart:  currently active Sportart filter (or nil)
%>
<%
  offset = (angezeigt.wday + 6) % 7          # Monday-based leading blanks
  tage_im_monat = angezeigt.end_of_month.day
  wochen = ((offset + tage_im_monat) / 7.0).ceil
  gitter_start = angezeigt - offset
  heute = Date.current
  wochentage = %w[Mo Di Mi Do Fr Sa So]
%>
<div class="card">
  <div class="p-5 sm:p-6">
    <div class="mb-5 flex items-center justify-between">
      <p class="font-display text-lg font-bold text-neutral-900"><%= monatsname(angezeigt) %></p>
      <div class="flex items-center gap-2">
        <%= link_to zeitfenster_path(datum: datum.iso8601, sportart: sportart, monat: (angezeigt - 1.month).iso8601),
              class: "flex size-9 items-center justify-center rounded-full bg-white/60 text-neutral-600 ring-1 ring-inset ring-neutral-900/10 backdrop-blur-md transition-all duration-300 hover:-translate-y-px hover:bg-white hover:text-neutral-900 hover:no-underline",
              aria: { label: "Vorheriger Monat" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
        <% end %>
        <%= link_to zeitfenster_path(datum: datum.iso8601, sportart: sportart, monat: (angezeigt + 1.month).iso8601),
              class: "flex size-9 items-center justify-center rounded-full bg-white/60 text-neutral-600 ring-1 ring-inset ring-neutral-900/10 backdrop-blur-md transition-all duration-300 hover:-translate-y-px hover:bg-white hover:text-neutral-900 hover:no-underline",
              aria: { label: "Nächster Monat" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
        <% end %>
      </div>
    </div>

    <div class="mb-2 grid grid-cols-7 gap-1.5 sm:gap-2">
      <% wochentage.each do |wt| %>
        <div class="py-1 text-center text-[11px] font-bold uppercase tracking-wider text-neutral-400"><%= wt %></div>
      <% end %>
    </div>

    <div class="grid grid-cols-7 gap-1.5 sm:gap-2">
      <% (0...(wochen * 7)).each do |i| %>
        <% tag = gitter_start + i %>
        <% if tag.month != angezeigt.month %>
          <div class="kalender-tag kalender-tag-inaktiv kalender-tag-fremd" aria-hidden="true"><%= tag.day %></div>
        <% elsif tag == datum %>
          <span class="kalender-tag kalender-tag-aktiv" aria-current="date" aria-label="<%= tag.strftime("%d.%m.%Y") %> (ausgewählt)"><%= tag.day %></span>
        <% elsif tag < heute %>
          <div class="kalender-tag kalender-tag-inaktiv" aria-disabled="true" title="Vergangener Tag"><%= tag.day %></div>
        <% else %>
          <%= link_to zeitfenster_path(datum: tag.iso8601, sportart: sportart, monat: angezeigt.iso8601),
                class: "kalender-tag kalender-tag-frei relative", aria: { label: tag.strftime("%d.%m.%Y") } do %>
            <%= tag.day %>
            <% if tag == heute %>
              <span class="absolute inset-x-0 bottom-1.5 mx-auto size-1 rounded-full bg-primary-600" aria-hidden="true"></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
