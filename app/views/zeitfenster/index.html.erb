<% content_for :title, "Platzübersicht – PlatzFrei" %>

<%= render "shared/page_header",
      eyebrow: "Platzübersicht",
      title: "Freie Zeitfenster finden",
      description: "Wähle Datum und Sportart — reservierte Slots verschwinden in Echtzeit aus der Liste." %>

<%= render "shared/card", class: "mb-8", core_class: "!p-4 sm:!p-5" do %>
  <%= form_with url: zeitfenster_path, method: :get, class: "flex flex-col gap-4 sm:flex-row sm:items-end" do |f| %>
    <div class="flex-1">
      <%= f.label :datum, "Datum", class: "form-label" %>
      <%= f.date_field :datum, value: @datum, class: "form-input" %>
    </div>

    <div class="flex-1">
      <%= f.label :sportart, "Sportart", class: "form-label" %>
      <%= f.select :sportart, options_for_select(@sportarten, @sportart), { include_blank: "Alle Sportarten" }, class: "form-input" %>
    </div>

    <%= render "shared/button", label: "Filtern", variant: :primary, icon: :arrow %>
  <% end %>
<% end %>

<div class="mb-5 flex flex-wrap items-center gap-3">
  <span class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-neutral-700 ring-1 ring-inset ring-neutral-900/[0.07] tabular-nums">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-primary-600"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
    <%= @datum.strftime("%d.%m.%Y") %>
  </span>
  <span class="text-sm text-neutral-500"><%= pluralize(@zeitfenster.size, "Zeitfenster") %></span>
</div>

<% if @zeitfenster.empty? %>
  <%= render "shared/empty_state",
        title: "Keine Zeitfenster gefunden",
        description: "Für diesen Tag und diese Sportart gibt es keine Einträge. Versuch ein anderes Datum oder entferne den Filter." %>
<% else %>
  <div class="panel hidden md:block">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Sportplatz</th>
          <th scope="col">Sportart</th>
          <th scope="col">Zeit</th>
          <th scope="col">Status</th>
          <th scope="col"><span class="sr-only">Details</span></th>
        </tr>
      </thead>
      <tbody>
        <% @zeitfenster.each do |zeitfenster| %>
          <tr>
            <td class="cell-strong"><%= zeitfenster.sportplatz.name %></td>
            <td><%= zeitfenster.sportplatz.sportart %></td>
            <td class="tabular-nums"><%= zeitfenster.start.strftime("%H:%M") %>–<%= zeitfenster.ende.strftime("%H:%M") %></td>
            <td><%= render "zeitfenster/status_badge", zeitfenster: zeitfenster %></td>
            <td class="text-right">
              <%= link_to zeitfenster_zeigen_path(zeitfenster), class: "group inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700 no-underline transition-colors duration-200 ease-fluid hover:underline" do %>
                Details
                <span class="flex size-5 items-center justify-center rounded-full bg-primary-600/10 transition-transform duration-300 ease-fluid group-hover:translate-x-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="space-y-3 md:hidden">
    <% @zeitfenster.each do |zeitfenster| %>
      <li>
        <%= link_to zeitfenster_zeigen_path(zeitfenster), class: "tile tile-interactive block no-underline hover:no-underline" do %>
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-semibold text-neutral-900"><%= zeitfenster.sportplatz.name %></p>
              <p class="text-sm text-neutral-500"><%= zeitfenster.sportplatz.sportart %></p>
            </div>
            <%= render "zeitfenster/status_badge", zeitfenster: zeitfenster %>
          </div>
          <p class="mt-3 flex items-center gap-1.5 text-sm text-neutral-600 tabular-nums">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-neutral-400"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            <%= zeitfenster.start.strftime("%H:%M") %>–<%= zeitfenster.ende.strftime("%H:%M") %>
          </p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
