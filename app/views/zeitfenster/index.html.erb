<% content_for :title, "Platzübersicht – PlatzFrei" %>

<% angezeigt = angezeigter_monat(@datum) %>
<%
  sportart_pille = lambda do |aktiv|
    class_names(
      "rounded-full px-4 py-2 text-sm font-medium no-underline ring-1 ring-inset transition-all duration-300 hover:no-underline",
      aktiv ? "bg-neutral-900 text-white ring-transparent hover:bg-neutral-900 hover:text-white" :
              "bg-white/60 text-neutral-700 ring-neutral-900/10 backdrop-blur-md hover:-translate-y-px hover:bg-white hover:text-neutral-900"
    )
  end
%>

<%= render "shared/page_header",
      eyebrow: "Platzübersicht",
      title: "Freie Zeitfenster finden",
      description: "Wähle Datum und Sportart — reservierte Slots verschwinden in Echtzeit aus der Liste." %>

<div class="mb-10 grid gap-4 lg:grid-cols-3 lg:items-start">
  <div class="lg:col-span-2">
    <%= render "zeitfenster/kalender", angezeigt: angezeigt, datum: @datum, sportart: @sportart %>
  </div>

  <%= render "shared/card", core_class: "p-5 sm:p-6" do %>
    <h3 class="mb-4 text-sm font-bold uppercase tracking-[0.12em] text-neutral-500">Sportart</h3>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Alle", zeitfenster_path(datum: @datum.iso8601, monat: angezeigt.iso8601), class: sportart_pille.call(@sportart.nil?) %>
      <% @sportarten.each do |sportart| %>
        <%= link_to sportart, zeitfenster_path(datum: @datum.iso8601, sportart: sportart, monat: angezeigt.iso8601), class: sportart_pille.call(@sportart == sportart) %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="mb-5 flex flex-wrap items-center gap-3">
  <span class="inline-flex items-center gap-2 rounded-full bg-white/60 px-4 py-2 text-sm font-semibold text-neutral-800 ring-1 ring-inset ring-white/60 backdrop-blur-md tabular-nums">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4 text-primary-600"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
    <%= @datum.strftime("%d.%m.%Y") %>
  </span>
  <span class="text-sm text-neutral-500"><%= pluralize(@zeitfenster.size, "Zeitfenster") %></span>
</div>

<% if @zeitfenster.empty? %>
  <%= render "shared/empty_state",
        title: "Keine Zeitfenster gefunden",
        description: "Für diesen Tag und diese Sportart gibt es keine Einträge. Versuch ein anderes Datum oder entferne den Filter." %>
<% else %>
  <div class="panel hidden md:block">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Sportplatz</th>
          <th scope="col">Sportart</th>
          <th scope="col">Zeit</th>
          <th scope="col">Status</th>
          <th scope="col"><span class="sr-only">Details</span></th>
        </tr>
      </thead>
      <tbody>
        <% @zeitfenster.each do |zeitfenster| %>
          <tr>
            <td class="cell-strong"><%= zeitfenster.sportplatz.name %></td>
            <td>
              <span class="inline-flex items-center gap-2.5">
                <%= render "zeitfenster/sportart_chip", sportart: zeitfenster.sportplatz.sportart %>
                <span class="font-medium text-neutral-700"><%= zeitfenster.sportplatz.sportart %></span>
              </span>
            </td>
            <td class="tabular-nums"><%= zeitfenster.start.strftime("%H:%M") %>–<%= zeitfenster.ende.strftime("%H:%M") %></td>
            <td><%= render "zeitfenster/status_badge", zeitfenster: zeitfenster %></td>
            <td class="text-right">
              <%= link_to "Details", zeitfenster_zeigen_path(zeitfenster),
                    class: "inline-flex items-center gap-1.5 rounded-full bg-white/60 px-3.5 py-1.5 text-sm font-semibold text-primary-700 no-underline ring-1 ring-inset ring-neutral-900/10 backdrop-blur-md transition-all duration-300 hover:-translate-y-px hover:bg-white hover:no-underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="space-y-3 md:hidden">
    <% @zeitfenster.each do |zeitfenster| %>
      <li>
        <%= link_to zeitfenster_zeigen_path(zeitfenster), class: "tile tile-interactive block no-underline hover:no-underline" do %>
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-3">
              <%= render "zeitfenster/sportart_chip", sportart: zeitfenster.sportplatz.sportart %>
              <div>
                <p class="font-semibold text-neutral-900"><%= zeitfenster.sportplatz.name %></p>
                <p class="text-sm text-neutral-500"><%= zeitfenster.sportplatz.sportart %></p>
              </div>
            </div>
            <%= render "zeitfenster/status_badge", zeitfenster: zeitfenster %>
          </div>
          <p class="mt-3 flex items-center gap-1.5 text-sm text-neutral-600 tabular-nums">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-neutral-400"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            <%= zeitfenster.start.strftime("%H:%M") %>–<%= zeitfenster.ende.strftime("%H:%M") %>
          </p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
