<% content_for :title, "Platzübersicht – PlatzFrei" %>

<%= render "shared/page_header",
      title: "Platzübersicht",
      description: "Wähle Datum und Sportart, um freie Zeitfenster zu finden." %>

<%= render "shared/card", class: "mb-6 !p-4 sm:!p-5" do %>
  <%= form_with url: zeitfenster_path, method: :get, class: "flex flex-col gap-4 sm:flex-row sm:items-end" do |f| %>
    <div class="flex-1">
      <%= f.label :datum, "Datum", class: "form-label" %>
      <%= f.date_field :datum, value: @datum, class: "form-input" %>
    </div>

    <div class="flex-1">
      <%= f.label :sportart, "Sportart", class: "form-label" %>
      <%= f.select :sportart, options_for_select(@sportarten, @sportart), { include_blank: "Alle Sportarten" }, class: "form-input" %>
    </div>

    <%= render "shared/button", label: "Filtern", variant: :primary %>
  <% end %>
<% end %>

<div class="mb-4 flex items-center justify-between">
  <p class="text-sm text-neutral-500">
    <span class="font-semibold text-neutral-700 tabular-nums"><%= @datum.strftime("%d.%m.%Y") %></span>
    · <%= pluralize(@zeitfenster.size, "Zeitfenster") %>
  </p>
</div>

<% if @zeitfenster.empty? %>
  <%= render "shared/empty_state",
        title: "Keine Zeitfenster gefunden",
        description: "Für diesen Tag und diese Sportart gibt es keine Einträge. Versuch ein anderes Datum oder entferne den Filter." %>
<% else %>
  <div class="panel hidden md:block">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Sportplatz</th>
          <th scope="col">Sportart</th>
          <th scope="col">Zeit</th>
          <th scope="col">Status</th>
          <th scope="col"><span class="sr-only">Details</span></th>
        </tr>
      </thead>
      <tbody>
        <% @zeitfenster.each do |zeitfenster| %>
          <tr>
            <td class="cell-strong"><%= zeitfenster.sportplatz.name %></td>
            <td><%= zeitfenster.sportplatz.sportart %></td>
            <td class="tabular-nums"><%= zeitfenster.start.strftime("%H:%M") %>–<%= zeitfenster.ende.strftime("%H:%M") %></td>
            <td><%= render "zeitfenster/status_badge", zeitfenster: zeitfenster %></td>
            <td class="text-right">
              <%= link_to zeitfenster_zeigen_path(zeitfenster), class: "inline-flex items-center gap-1 text-sm font-semibold text-primary-700 no-underline hover:underline" do %>
                Details
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="space-y-3 md:hidden">
    <% @zeitfenster.each do |zeitfenster| %>
      <li>
        <%= link_to zeitfenster_zeigen_path(zeitfenster),
              class: "block rounded-2xl border border-neutral-200 bg-white p-4 no-underline transition-colors hover:border-primary-300 hover:no-underline" do %>
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-semibold text-neutral-900"><%= zeitfenster.sportplatz.name %></p>
              <p class="text-sm text-neutral-500"><%= zeitfenster.sportplatz.sportart %></p>
            </div>
            <%= render "zeitfenster/status_badge", zeitfenster: zeitfenster %>
          </div>
          <p class="mt-3 flex items-center gap-1.5 text-sm text-neutral-600 tabular-nums">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-neutral-400"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            <%= zeitfenster.start.strftime("%H:%M") %>–<%= zeitfenster.ende.strftime("%H:%M") %>
          </p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
