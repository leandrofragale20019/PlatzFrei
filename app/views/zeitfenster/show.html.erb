<% content_for :title, "#{@zeitfenster.sportplatz.name} – PlatzFrei" %>

<div class="mx-auto max-w-xl">
  <%= link_to zeitfenster_path, class: "link-muted mb-5" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
    Zurück zur Übersicht
  <% end %>

  <%= render "shared/card", core_class: "!p-0 overflow-hidden" do %>
    <div class="flex items-start justify-between gap-4 p-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-neutral-400"><%= @zeitfenster.sportplatz.sportart %></p>
        <h1 class="mt-1 text-2xl"><%= @zeitfenster.sportplatz.name %></h1>
      </div>
      <%= render "zeitfenster/status_badge", zeitfenster: @zeitfenster %>
    </div>

    <div class="px-6">
      <%= render "shared/detail_row", label: "Datum" do %><span class="tabular-nums"><%= @zeitfenster.start.strftime("%d.%m.%Y") %></span><% end %>
      <%= render "shared/detail_row", label: "Zeit" do %><span class="tabular-nums"><%= @zeitfenster.start.strftime("%H:%M") %>–<%= @zeitfenster.ende.strftime("%H:%M") %></span><% end %>
    </div>

    <div class="mt-2 border-t border-neutral-100 bg-neutral-50/70 p-6">
      <% if @zeitfenster.gesperrt? %>
        <div class="flex items-center gap-3 text-sm text-neutral-600">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-neutral-200 text-neutral-500">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
          </span>
          Dieser Platz ist für diesen Zeitraum gesperrt.
        </div>
      <% elsif @zeitfenster.aktive_reservierung.present? %>
        <p class="mb-4 text-sm text-neutral-600">Dieses Zeitfenster ist bereits reserviert.</p>

        <% if @bereits_auf_warteliste %>
          <div class="flex items-center gap-2 text-sm font-medium text-neutral-700">
            <%= render "shared/badge", label: "Auf Warteliste", variant: :warning %>
            Du wirst benachrichtigt, sobald der Platz frei wird.
          </div>
        <% else %>
          <%= form_with url: wartelisten_path, method: :post do %>
            <%= hidden_field_tag :zeitfenster_id, @zeitfenster.id %>
            <%= render "shared/button", label: "Auf Warteliste setzen", variant: :secondary, class: "w-full sm:w-auto" %>
          <% end %>
          <p class="form-hint">Wird der Platz storniert, rückst du automatisch nach.</p>
        <% end %>
      <% else %>
        <%= form_with url: reservierungen_path, method: :post do %>
          <%= hidden_field_tag :zeitfenster_id, @zeitfenster.id %>
          <%= render "shared/button", label: "Jetzt reservieren", variant: :primary, icon: :arrow, class: "w-full sm:w-auto",
                confirm: "Zeitfenster am #{@zeitfenster.start.strftime('%d.%m.%Y %H:%M')} verbindlich reservieren?" %>
        <% end %>
        <p class="form-hint">Verbindliche Reservierung — jederzeit unter „Meine Reservierungen" stornierbar.</p>
      <% end %>
    </div>
  <% end %>
</div>
