<h1>Registrieren</h1>

<% if @benutzer.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@benutzer.errors.count, "Fehler") %> haben die Registrierung verhindert:</h2>
    <ul>
      <% @benutzer.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @benutzer, url: registrierung_path do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email, "E-Mail" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "Passwort" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Passwort bestätigen" %>
    <%= form.password_field :password_confirmation %>
  </div>

  <div>
    <%= form.submit "Registrieren" %>
  </div>
<% end %>

<%= link_to "Bereits ein Konto? Anmelden", new_sitzung_path %>
