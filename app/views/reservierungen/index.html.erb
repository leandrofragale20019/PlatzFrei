<% content_for :title, "Meine Reservierungen – PlatzFrei" %>

<%= render "shared/page_header",
      eyebrow: "Mein Konto",
      title: "Meine Reservierungen",
      description: "Deine gebuchten Zeitfenster und Wartelisten-Einträge auf einen Blick." do %>
  <%= render "shared/button", label: "Platz reservieren", variant: :primary, href: zeitfenster_path %>
<% end %>

<% if @durch_sperrung_storniert.any? %>
  <div class="mb-8 rounded-2xl border border-warning-600/25 bg-warning-50 px-4 py-3.5 text-sm text-warning-800" role="status">
    <p class="font-semibold">Wegen einer Platzsperrung storniert</p>
    <ul class="mt-1.5 space-y-0.5">
      <% @durch_sperrung_storniert.each do |reservierung| %>
        <li class="tabular-nums">
          <%= reservierung.zeitfenster.sportplatz.name %>, <%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<section class="mb-12">
  <div class="mb-4 flex items-baseline gap-3">
    <h2>Gebucht</h2>
    <span class="text-sm text-neutral-400 tabular-nums"><%= @reservierungen.size %></span>
  </div>

  <% if @reservierungen.empty? %>
    <%= render "shared/empty_state",
          title: "Noch keine Reservierungen",
          description: "Sobald du ein Zeitfenster reservierst, erscheint es hier." do %>
      <%= render "shared/button", label: "Freie Plätze ansehen", variant: :primary, href: zeitfenster_path %>
    <% end %>
  <% else %>
    <div class="panel hidden md:block">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Sportart</span></th>
            <th scope="col">Sportplatz</th>
            <th scope="col">Zeit</th>
            <th scope="col"><span class="sr-only">Aktion</span></th>
          </tr>
        </thead>
        <tbody>
          <% @reservierungen.each do |reservierung| %>
            <tr>
              <td class="w-px pr-0"><%= render "zeitfenster/sportart_chip", sportart: reservierung.zeitfenster.sportplatz.sportart %></td>
              <td class="cell-strong"><%= reservierung.zeitfenster.sportplatz.name %></td>
              <td class="tabular-nums"><%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></td>
              <td class="text-right">
                <%= render "shared/button", label: "Stornieren", variant: :danger,
                      href: reservierung_path(reservierung), method: :delete,
                      params: { lock_version: reservierung.lock_version },
                      confirm: "Reservierung wirklich stornieren?" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3 md:hidden">
      <% @reservierungen.each do |reservierung| %>
        <li class="tile">
          <div class="flex items-center gap-3">
            <%= render "zeitfenster/sportart_chip", sportart: reservierung.zeitfenster.sportplatz.sportart %>
            <div>
              <p class="font-semibold text-neutral-900"><%= reservierung.zeitfenster.sportplatz.name %></p>
              <p class="mt-0.5 text-sm text-neutral-600 tabular-nums"><%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></p>
            </div>
          </div>
          <div class="mt-3">
            <%= render "shared/button", label: "Stornieren", variant: :danger,
                  href: reservierung_path(reservierung), method: :delete,
                  params: { lock_version: reservierung.lock_version },
                  confirm: "Reservierung wirklich stornieren?", class: "w-full" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section>
  <div class="mb-4 flex items-baseline gap-3">
    <h2>Warteliste</h2>
    <span class="text-sm text-neutral-400 tabular-nums"><%= @wartelisten.size %></span>
  </div>

  <% if @wartelisten.empty? %>
    <%= render "shared/empty_state",
          icon: "M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5",
          title: "Keine Wartelisten-Einträge",
          description: "Ist ein Wunsch-Zeitfenster belegt, kannst du dich auf die Warteliste setzen." %>
  <% else %>
    <div class="panel hidden md:block">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Sportart</span></th>
            <th scope="col">Sportplatz</th>
            <th scope="col">Zeit</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @wartelisten.each do |eintrag| %>
            <tr>
              <td class="w-px pr-0"><%= render "zeitfenster/sportart_chip", sportart: eintrag.zeitfenster.sportplatz.sportart %></td>
              <td class="cell-strong"><%= eintrag.zeitfenster.sportplatz.name %></td>
              <td class="tabular-nums"><%= eintrag.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></td>
              <td><%= render "wartelisten/status", eintrag: eintrag %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3 md:hidden">
      <% @wartelisten.each do |eintrag| %>
        <li class="tile">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <%= render "zeitfenster/sportart_chip", sportart: eintrag.zeitfenster.sportplatz.sportart %>
              <div>
                <p class="font-semibold text-neutral-900"><%= eintrag.zeitfenster.sportplatz.name %></p>
                <p class="mt-0.5 text-sm text-neutral-600 tabular-nums"><%= eintrag.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></p>
              </div>
            </div>
            <%= render "wartelisten/status", eintrag: eintrag %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
