<% content_for :title, "Meine Reservierungen – PlatzFrei" %>

<%= render "shared/page_header",
      title: "Meine Reservierungen",
      description: "Deine gebuchten Zeitfenster und Wartelisten-Einträge." do %>
  <%= render "shared/button", label: "Platz reservieren", variant: :primary, href: zeitfenster_path %>
<% end %>

<section class="mb-10">
  <h2 class="mb-4">Gebucht</h2>

  <% if @reservierungen.empty? %>
    <%= render "shared/empty_state",
          title: "Noch keine Reservierungen",
          description: "Sobald du ein Zeitfenster reservierst, erscheint es hier." do %>
      <%= render "shared/button", label: "Freie Plätze ansehen", variant: :primary, href: zeitfenster_path %>
    <% end %>
  <% else %>
    <div class="panel hidden md:block">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Sportplatz</th>
            <th scope="col">Zeit</th>
            <th scope="col"><span class="sr-only">Aktion</span></th>
          </tr>
        </thead>
        <tbody>
          <% @reservierungen.each do |reservierung| %>
            <tr>
              <td class="cell-strong"><%= reservierung.zeitfenster.sportplatz.name %></td>
              <td class="tabular-nums"><%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></td>
              <td class="text-right">
                <%= render "shared/button", label: "Stornieren", variant: :danger,
                      href: reservierung_path(reservierung), method: :delete,
                      confirm: "Reservierung wirklich stornieren?" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3 md:hidden">
      <% @reservierungen.each do |reservierung| %>
        <li class="rounded-2xl border border-neutral-200 bg-white p-4">
          <p class="font-semibold text-neutral-900"><%= reservierung.zeitfenster.sportplatz.name %></p>
          <p class="mt-1 text-sm text-neutral-600 tabular-nums"><%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></p>
          <div class="mt-3">
            <%= render "shared/button", label: "Stornieren", variant: :danger,
                  href: reservierung_path(reservierung), method: :delete,
                  confirm: "Reservierung wirklich stornieren?", class: "w-full" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section>
  <h2 class="mb-4">Warteliste</h2>

  <% if @wartelisten.empty? %>
    <%= render "shared/empty_state",
          icon: "M3.75 5.25h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5m-16.5 4.5h16.5",
          title: "Keine Wartelisten-Einträge",
          description: "Ist ein Wunsch-Zeitfenster belegt, kannst du dich auf die Warteliste setzen." %>
  <% else %>
    <div class="panel hidden md:block">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Sportplatz</th>
            <th scope="col">Zeit</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @wartelisten.each do |eintrag| %>
            <tr>
              <td class="cell-strong"><%= eintrag.zeitfenster.sportplatz.name %></td>
              <td class="tabular-nums"><%= eintrag.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></td>
              <td><%= render "wartelisten/status", eintrag: eintrag %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="space-y-3 md:hidden">
      <% @wartelisten.each do |eintrag| %>
        <li class="rounded-2xl border border-neutral-200 bg-white p-4">
          <p class="font-semibold text-neutral-900"><%= eintrag.zeitfenster.sportplatz.name %></p>
          <p class="mt-1 text-sm text-neutral-600 tabular-nums"><%= eintrag.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></p>
          <div class="mt-2"><%= render "wartelisten/status", eintrag: eintrag %></div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
