<% content_for :title, "Protokoll – Verwaltung" %>

<%= render "shared/page_header",
      eyebrow: "Verwaltung",
      title: "Aktivitätsprotokoll",
      description: "Jede Reservierung, Stornierung und Sperrung, mit Zeitpunkt und handelnder Person." %>

<% if @protokolle.empty? %>
  <%= render "shared/empty_state",
        icon: "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z",
        title: "Noch keine Aktivität",
        description: "Sobald Reservierungen oder Sperrungen passieren, werden sie hier protokolliert." %>
<% else %>
  <div class="panel hidden md:block">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Zeitpunkt</th>
          <th scope="col">Aktion</th>
          <th scope="col">Akteur</th>
          <th scope="col">Mitglied</th>
          <th scope="col">Sportplatz</th>
          <th scope="col">Zeit</th>
        </tr>
      </thead>
      <tbody>
        <% @protokolle.each do |protokoll| %>
          <tr>
            <td class="whitespace-nowrap tabular-nums text-neutral-500"><%= protokoll.zeitpunkt.strftime("%d.%m.%Y %H:%M") %></td>
            <td>
              <% aktion_variant = { "erstellt" => :success, "storniert" => :error, "geschlossen" => :neutral, "entsperrt" => :primary }.fetch(protokoll.aktion, :neutral) %>
              <%= render "shared/badge", label: protokoll.aktion, variant: aktion_variant %>
            </td>
            <td class="cell-strong"><%= protokoll.akteur.name %></td>
            <td><%= protokoll.reservierung&.benutzer&.name || "–" %></td>
            <td><%= protokoll.betroffenes_zeitfenster.sportplatz.name %></td>
            <td class="whitespace-nowrap tabular-nums text-neutral-500"><%= protokoll.betroffenes_zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="space-y-3 md:hidden">
    <% @protokolle.each do |protokoll| %>
      <li class="tile">
        <div class="flex items-center justify-between gap-2">
          <% aktion_variant = { "erstellt" => :success, "storniert" => :error, "geschlossen" => :neutral, "entsperrt" => :primary }.fetch(protokoll.aktion, :neutral) %>
          <%= render "shared/badge", label: protokoll.aktion, variant: aktion_variant %>
          <span class="text-xs text-neutral-400 tabular-nums"><%= protokoll.zeitpunkt.strftime("%d.%m.%Y %H:%M") %></span>
        </div>
        <dl class="mt-3 space-y-1 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-neutral-500">Akteur</dt><dd class="font-medium text-neutral-800"><%= protokoll.akteur.name %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-neutral-500">Mitglied</dt><dd class="text-neutral-700"><%= protokoll.reservierung&.benutzer&.name || "–" %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-neutral-500">Sportplatz</dt><dd class="text-neutral-700"><%= protokoll.betroffenes_zeitfenster.sportplatz.name %></dd></div>
          <div class="flex justify-between gap-4"><dt class="text-neutral-500">Zeit</dt><dd class="text-neutral-700 tabular-nums"><%= protokoll.betroffenes_zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></dd></div>
        </dl>
      </li>
    <% end %>
  </ul>
<% end %>
