<% content_for :title, "Reservierungen – Verwaltung" %>

<%= render "shared/page_header",
      eyebrow: "Verwaltung",
      title: "Reservierungen",
      description: "Alle aktiven Reservierungen — bei Missbrauch stornierbar." %>

<% if @reservierungen.empty? %>
  <%= render "shared/empty_state",
        icon: "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
        title: "Keine aktiven Reservierungen",
        description: "Aktuell ist kein Zeitfenster reserviert." %>
<% else %>
  <div class="panel hidden md:block">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Mitglied</th>
          <th scope="col">Sportplatz</th>
          <th scope="col">Zeit</th>
          <th scope="col"><span class="sr-only">Aktion</span></th>
        </tr>
      </thead>
      <tbody>
        <% @reservierungen.each do |reservierung| %>
          <tr>
            <td class="cell-strong"><%= reservierung.benutzer.name %></td>
            <td><%= reservierung.zeitfenster.sportplatz.name %></td>
            <td class="tabular-nums"><%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></td>
            <td class="text-right">
              <%= render "shared/button", label: "Stornieren", variant: :danger,
                    href: admin_reservierung_path(reservierung), method: :delete,
                    confirm: "Reservierung von #{reservierung.benutzer.name} wirklich stornieren?" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="space-y-3 md:hidden">
    <% @reservierungen.each do |reservierung| %>
      <li class="tile">
        <p class="font-semibold text-neutral-900"><%= reservierung.benutzer.name %></p>
        <p class="mt-1 text-sm text-neutral-600"><%= reservierung.zeitfenster.sportplatz.name %></p>
        <p class="text-sm text-neutral-500 tabular-nums"><%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></p>
        <div class="mt-3">
          <%= render "shared/button", label: "Stornieren", variant: :danger,
                href: admin_reservierung_path(reservierung), method: :delete,
                confirm: "Reservierung von #{reservierung.benutzer.name} wirklich stornieren?", class: "w-full" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
