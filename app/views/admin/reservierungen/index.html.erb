<h1>Alle Reservierungen</h1>

<table>
  <thead>
    <tr>
      <th>Mitglied</th>
      <th>Sportplatz</th>
      <th>Zeit</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @reservierungen.each do |reservierung| %>
      <tr>
        <td><%= reservierung.benutzer.name %></td>
        <td><%= reservierung.zeitfenster.sportplatz.name %></td>
        <td><%= reservierung.zeitfenster.start.strftime("%d.%m.%Y %H:%M") %></td>
        <td>
          <%= button_to "Stornieren", admin_reservierung_path(reservierung), method: :delete,
                data: { turbo_confirm: "Reservierung von #{reservierung.benutzer.name} wirklich stornieren?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
