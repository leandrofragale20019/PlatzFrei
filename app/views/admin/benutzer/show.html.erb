<% content_for :title, "#{@benutzer.name} – Verwaltung" %>

<div class="mx-auto max-w-2xl">
  <%= link_to "Zurück zur Übersicht", admin_benutzer_path, class: "link-muted mb-5" %>

  <%= render "shared/card" do %>
    <div class="mb-6 flex items-center gap-4 border-b border-neutral-100 pb-6">
      <div class="flex size-16 items-center justify-center rounded-2xl bg-neutral-200 text-2xl font-bold text-neutral-600" style="font-family: var(--font-display)">
        <%= @benutzer.name.first&.upcase %>
      </div>
      <div>
        <p class="font-display text-xl font-bold text-neutral-900"><%= @benutzer.name %></p>
        <div class="mt-1.5">
          <%= render "shared/badge",
                label: @benutzer.verantwortlicher? ? "Platzverantwortliche/r" : "Vereinsmitglied",
                variant: @benutzer.verantwortlicher? ? :primary : :neutral %>
        </div>
      </div>
    </div>

    <%= render "shared/detail_row", label: "E-Mail" do %><%= @benutzer.email %><% end %>
    <%= render "shared/detail_row", label: "Rolle" do %><%= @benutzer.verantwortlicher? ? "Platzverantwortliche/r" : "Vereinsmitglied" %><% end %>
    <%= render "shared/detail_row", label: "Mitglied seit" do %><span class="tabular-nums"><%= @benutzer.created_at.strftime("%d.%m.%Y") %></span><% end %>
  <% end %>
</div>
