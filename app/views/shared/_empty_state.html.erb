<%#
  Composed empty state: a typographic message (+ optional CTA block), so blank
  lists never look like a rendering bug. No icon by design.

  Locals:
    title:       headline (required)
    description: optional supporting line
    icon:        accepted for backward compatibility, intentionally ignored
  Block: optional call-to-action (e.g. a button).
%>
<% cta = capture { yield } if block_given? %>
<div class="flex flex-col items-center justify-center rounded-3xl border border-white/70 bg-white/40 px-6 py-16 text-center backdrop-blur-xl">
  <p class="font-display text-xl font-medium text-neutral-900"><%= title %></p>
  <% if local_assigns[:description].present? %>
    <p class="mt-2 max-w-sm text-sm text-neutral-500"><%= description %></p>
  <% end %>
  <% if cta.present? %>
    <div class="mt-6"><%= cta %></div>
  <% end %>
</div>
