<%# Admin console context bar — a floating dark ink pill that marks the
    management area as its own space, with its own active-state navigation. %>
<div class="mt-3 rounded-2xl bg-ink-900 px-3 py-2 shadow-[0_18px_40px_-24px_rgba(13,17,27,0.7)] ring-1 ring-inset ring-white/10">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
    <div class="flex items-center gap-2 px-2 sm:border-r sm:border-white/10 sm:pr-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 text-primary-300">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
      </svg>
      <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-neutral-300">Verwaltung</span>
    </div>

    <nav class="flex flex-wrap items-center gap-1" aria-label="Verwaltung">
      <% admin_navigation.each do |link| %>
        <%= link_to link[:label], link[:path],
              class: class_names("subnav-link", "subnav-link-active" => nav_aktiv?(link[:path])),
              aria: { current: ("page" if nav_aktiv?(link[:path])) } %>
      <% end %>
    </nav>
  </div>
</div>
