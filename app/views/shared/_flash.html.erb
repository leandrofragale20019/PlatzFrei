<%# Renders every flash message with a consistent success/error/info style. %>
<% flash.each do |art, nachricht| %>
  <%
    classes, icon_path = case art.to_s
    when "notice"
      [ "bg-success-50 text-success-800 border-success-200", "M4.5 12.75l6 6 9-13.5" ]
    when "alert"
      [ "bg-error-50 text-error-800 border-error-200", "M12 9v3.75m0 3.75h.008v.008H12v-.008ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" ]
    else
      [ "bg-neutral-100 text-neutral-800 border-neutral-200", "M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" ]
    end
  %>
  <div class="mb-4 flex items-start gap-2 rounded-md border px-4 py-3 text-sm <%= classes %>" role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 size-5 shrink-0">
      <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>" />
    </svg>
    <p><%= nachricht %></p>
  </div>
<% end %>
